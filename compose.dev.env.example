# Copy to the ignored root .env file before starting compose.dev.yaml.
POSTGRES_DB=trasolve
POSTGRES_USER=trasolve
POSTGRES_PASSWORD=trasolve-dev
DATABASE_URL=postgresql://trasolve:trasolve-dev@postgres:5432/trasolve

# Local is the default debug persistence. Set postgres to exercise migrations
# and the production repository path against the postgres service above.
TRASOLVE_PERSISTENCE_MODE=local

# External provider control. Production images require the explicit second flag
# before mock can be selected.
TRASOLVE_EXTERNAL_API_MODE=enabled
TRASOLVE_EXTERNAL_API_MOCK_ALLOW_PRODUCTION=false
VITE_EXTERNAL_API_MODE=enabled

# Optional until Google login is configured for this origin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/auth/google/callback

# Do not populate these in disabled/mock performance environments.
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=

# Optional OpenWebUI provider settings for local integration testing.
AI_PROVIDER=
OPENWEBUI_API_KEY=
OPENWEBUI_BASE_URL=https://chat.mangagaki.net
OPENWEBUI_MODEL=gpt-6.1-sol

# Optional host port overrides.
POSTGRES_PORT=5432
BACKEND_PORT=43127
FRONTEND_PORT=4173
