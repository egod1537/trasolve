{
	auto_https off
	admin off
}

:3000 {
	root * /srv
	encode zstd gzip

	@immutableAssets {
		path /assets/*
		file {path}
	}
	handle @immutableAssets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Missing build chunks must not fall back to HTML or become cached failures.
	handle /assets/* {
		header Cache-Control "no-store"
		respond 404
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
