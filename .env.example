# Copy deployment-host settings to ~/.config/jjs/deploy.env and chmod 600 it.
# Do not put real tokens or credential contents in this repository.

JJS_DOMAIN=mangagaki.net
JJS_SERVICE_NAME=jjs
JJS_MAIN_BRANCH=main
JJS_MAIN_HOSTNAME=jjs.mangagaki.net
# Optional comma-separated aliases served by main only. Set an empty value to disable aliases.
JJS_MAIN_ALIASES=trasolve.mangagaki.net

JJS_AUTO_DEPLOY_MAIN=true
JJS_AUTO_DEPLOY_RETRY_SEC=300
# Optional comma-separated exact branch names, for example: legacy,w0
JJS_AUTO_DEPLOY_EXCLUDED_BRANCHES=
JJS_HEALTH_TIMEOUT_SEC=120
JJS_EXTERNAL_HEALTHCHECK=false

# Keep enabled for normal deployments. Performance-test builds set both backend
# and frontend modes explicitly and do not receive provider keys.
TRASOLVE_EXTERNAL_API_MODE=enabled
TRASOLVE_EXTERNAL_API_MOCK_ALLOW_PRODUCTION=false
VITE_EXTERNAL_API_MODE=enabled

JJS_STATE_DIR=/Users/you/.local/state/jjs
JJS_CLOUDFLARED_CONFIG_PATH=/Users/you/.config/jjs/cloudflared/config.yml
JJS_CLOUDFLARED_CREDENTIALS=/Users/you/.config/jjs/cloudflared/credentials.json
JJS_CLOUDFLARED_ORIGIN_CERT=/Users/you/.cloudflared/cert.pem
JJS_CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
JJS_AUTO_PROVISION_DNS=true

JJS_GITHUB_REPOSITORY=egod1537/trasolve
JJS_GITHUB_TOKEN=
JJS_GITHUB_REPORTING_REQUIRED=false
# JJS_GITHUB_API_URL=https://api.github.com
# JJS_GITHUB_API_VERSION=2022-11-28

# Frontend build inputs. Keep the real browser key only in the deployment-host copy.
JJS_GOOGLE_MAPS_API_KEY=
JJS_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
JJS_SENTRY_DSN=

# Backend runtime key with Routes API enabled (separate from the browser key).
GOOGLE_ROUTES_API_KEY=
# Backend runtime key with Places API (New) enabled. Never a frontend build input.
GOOGLE_PLACES_API_KEY=

# Backend AI provider. Keep these credentials only in the deployment-host copy.
AI_PROVIDER=openwebui
OPENWEBUI_API_KEY=
OPENWEBUI_BASE_URL=https://chat.mangagaki.net
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Server-to-server troute endpoint passed only to the backend container.
TROUTE_BASE_URL=https://troute.mangagaki.net/api/
# Enable only after the deployed troute accepts partial-visit fields.
TROUTE_PARTIAL_VISIT_ENABLED=false
TCACHE_BASE_URL=https://tcache.mangagaki.net

# Backend-only PostgreSQL credentials. Generate an alphanumeric password for the host.
# Each deployment derives an isolated database name from its branch slug.
# Never expose this value as VITE_*.
JJS_POSTGRES_PASSWORD=

# Google OAuth server credentials. These are passed only to the backend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Deployments derive GOOGLE_OAUTH_REDIRECT_URI from each branch hostname.
# Backend-only administrator CSRF signing secret (32+ random bytes).
TRASOLVE_ADMIN_CSRF_SECRET=
# Exact public browser origin used for administrator Origin validation.
TRASOLVE_PUBLIC_ORIGIN=

# Localization sync. Store real credentials only in the ignored root .env.local
# or inject them through the shell/CI environment. Keep the JSON on one line.
LOCALIZATION_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"example-project","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"localization-reader@example-project.iam.gserviceaccount.com","client_id":"000000000000000000000"}

# Optional SSO callback for nonstandard/local hosting. Production deployments
# preserve the host routed by the trusted private Caddy ingress.
# This is a public callback URL, never a school username or password.
# SSU_SSO_REDIRECT_URI=https://example.com/api/auth/ssu/callback

# Backend-only Toss API individual-integration keys. Use a matching test pair
# first; replacing both with live keys selects a separate live wallet.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# Separate automatic-billing MID keys; both pairs must use test or both live.
TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
# Base64-encoded 32-byte AES key for stored billing keys. Back up before rotation.
TRASOLVE_PAYMENT_ENCRYPTION_KEY=
# URL debug flags do not select the self-contained payment simulator.
TRASOLVE_DEBUG_PAYMENTS=false
TRASOLVE_TOKEN_CHAT_COST=10
TRASOLVE_TOKEN_OPTIMIZE_COST=50
TRASOLVE_PLUS_PRICE=4900
TRASOLVE_PRO_PRICE=9900
TRASOLVE_TOPUP_20K_PRICE=4900
TRASOLVE_TOPUP_50K_PRICE=9900
