# Copy to backend/.env.local. Use server keys restricted to their respective APIs.
# Do not use the browser key restricted by HTTP referrers.
# Local backend listener. Production explicitly uses port 3000 in Docker.
PORT=43127

# Paid/remote provider calls: enabled (default), disabled, or mock.
TRASOLVE_EXTERNAL_API_MODE=enabled
# Production containers reject mock unless this explicit tperf-only override is true.
TRASOLVE_EXTERNAL_API_MOCK_ALLOW_PRODUCTION=false

# Debug defaults to local file persistence. Set postgres to exercise the
# production persistence path locally; production defaults to postgres.
TRASOLVE_PERSISTENCE_MODE=local

# Enables the debug-only guest session endpoint. Local development defaults to
# enabled; production requires this explicit opt-in.
TRASOLVE_DEBUG_GUEST_AUTH=true
TRASOLVE_DEBUG_GUEST_SUBJECT=default
# auto: honor ?debug=1 token bypass only while debug guest auth is enabled.
# false always meters; true authorizes the URL marker in any sandbox runtime.
# Live payment keys always keep real token metering regardless of this setting.
TRASOLVE_DEBUG_UNLIMITED_TOKENS=auto

# Browser origin allowed to make billing mutations. This must exactly match the
# Vite development server origin below.
TRASOLVE_PUBLIC_ORIGIN=http://127.0.0.1:5173

# One-time Toss token top-ups. Paste a matching test_ck/test_sk API individual-
# integration key pair from the same MID into backend/.env.local.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# Keep automatic billing disabled until a separate billing MID and encryption
# key are configured. The one-time top-up flow does not use a Toss security key.
TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
TRASOLVE_PAYMENT_ENCRYPTION_KEY=
# URL debug flags must not select the self-contained payment simulator.
TRASOLVE_DEBUG_PAYMENTS=false

# Required only when TRASOLVE_PERSISTENCE_MODE=postgres. Keep credentials
# server-side.
DATABASE_URL=postgresql://trasolve:trasolve-dev@127.0.0.1:5432/trasolve

# Google OAuth. The redirect URI must exactly match the provider configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback

# Routes API
GOOGLE_ROUTES_API_KEY=
# Places API (New). Never expose this key through a VITE_ variable.
GOOGLE_PLACES_API_KEY=

# AI chat provider: openwebui, gemini, or random.
# If omitted, an available OpenWebUI key keeps the existing local behavior;
# otherwise the backend uses the development-only random provider.
AI_PROVIDER=

# OpenWebUI Responses API. The server uses /openai/models and /openai/responses.
# Keep all credentials server-side and select a model returned by the model API.
OPENWEBUI_API_KEY=
# OPENWEBUI_BASE_URL=https://chat.mangagaki.net
# Optional when the OpenWebUI hostname is protected by Cloudflare Access.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Gemini Developer API. Keep the API key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set to 1 to let Gemini propose trip edits through function calling.
# Off by default: the text JSON Plan path is used.
GEMINI_NATIVE_TOOLS=
# Local stub only. The API key header is sent to this URL, so only the Google
# https URL or a loopback URL (127.0.0.1, localhost, [::1]) ending with a slash
# is accepted. It replaces both /v1/ and /v1beta/. Blank means the default.
# GEMINI_API_BASE_URL=

# troute server-to-server API. Do not expose this through a VITE_ variable.
TROUTE_BASE_URL=http://127.0.0.1:18080
# Send visit_policy and per-location required/priority fields to compatible troute servers.
TROUTE_PARTIAL_VISIT_ENABLED=false

# tcache server-to-server API. Do not expose this through a VITE_ variable.
TCACHE_BASE_URL=http://127.0.0.1:3200

# Local auth/session/Trip and internal job data root. Absolute path, or relative
# to the repository root. Defaults to .local/trasolve.
TRASOLVE_DATA_DIR=
