# Copy to backend/.env.local. Use server keys restricted to their respective APIs.
# Do not use the browser key restricted by HTTP referrers.
# Local backend listener. Production explicitly uses port 3000 in Docker.
PORT=43127

# Debug defaults to local file persistence. Set postgres to exercise the
# production persistence path locally; production defaults to postgres.
TRASOLVE_PERSISTENCE_MODE=local

# Required only when TRASOLVE_PERSISTENCE_MODE=postgres. Keep credentials
# server-side.
DATABASE_URL=postgresql://trasolve:trasolve-dev@127.0.0.1:5432/trasolve

# Google OAuth. The redirect URI must exactly match the provider configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback

# Routes API
GOOGLE_ROUTES_API_KEY=
# Places API (New). Never expose this key through a VITE_ variable.
GOOGLE_PLACES_API_KEY=
# Maps Static API for trip list thumbnails (optional; SVG fallback without it).
GOOGLE_STATIC_MAPS_API_KEY=

# AI chat provider: openwebui, gemini, or random.
# If omitted, an available OpenWebUI key keeps the existing local behavior;
# otherwise the backend uses the development-only random provider.
AI_PROVIDER=

# OpenWebUI Ollama-compatible API. Keep the API key server-side only.
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=
# OPENWEBUI_BASE_URL=https://chat.mangagaki.net

# Gemini Developer API. Keep the API key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# troute server-to-server API. Do not expose this through a VITE_ variable.
TROUTE_BASE_URL=http://127.0.0.1:18080

# tcache server-to-server API. Do not expose this through a VITE_ variable.
TCACHE_BASE_URL=http://127.0.0.1:3200

# Local auth/session/Trip and internal job data root. Absolute path, or relative
# to the repository root. Defaults to .local/trasolve.
TRASOLVE_DATA_DIR=
