{
  "name": "@trasolve/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "db:migrate": "tsx src/database/migrateCli.ts",
    "trip:migrate": "tsx src/trip/migration/migrateLegacyTripsCli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && node --import tsx --test test/trouteContract.test.ts",
    "start": "node dist/index.js",
    "db:migrate:production": "node dist/database/migrateCli.js",
    "trip:migrate:production": "node dist/trip/migration/migrateLegacyTripsCli.js"
  },
  "dependencies": {
    "@trasolve/shared": "0.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
