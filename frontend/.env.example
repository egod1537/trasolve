# Copy to frontend/.env.local and restart Vite after changing these values.
# Set disabled in tperf builds. This prevents both the Maps loader and Sentry
# initialization even if a key or DSN is accidentally present.
VITE_EXTERNAL_API_MODE=enabled
# Chat V2 is on by default. Set false to use the original chat.
VITE_USE_CHAT_V2=true
# First-use guide: auto, always, off. Overrides apply only in debug/development.
VITE_TUTORIAL_MODE=auto
# Maps JavaScript API only, restricted by HTTP referrers. Places uses the backend.
# Never reuse a backend key here. Routes and Places keys belong in backend/.env.local.
VITE_GOOGLE_MAPS_API_KEY=
# A dedicated JavaScript map ID is recommended for deployment.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Sentry Cloud Error Monitoring. Empty DSN keeps Sentry disabled.
VITE_SENTRY_DSN=
