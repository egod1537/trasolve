# Copy to frontend/.env.local and restart Vite after changing these values.
# Maps JavaScript API only, restricted by HTTP referrers. Places uses the backend.
# Never reuse a backend key here. Routes and Places keys belong in backend/.env.local.
VITE_GOOGLE_MAPS_API_KEY=
# A dedicated JavaScript map ID is recommended for deployment.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
